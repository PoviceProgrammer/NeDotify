# Secrets & Env
.env
*.env.local
secrets/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
# Covers every local variant: .venv, .venv_win, .venv_win_backup, venv.
# `.venv/` alone let the two Windows copies show up as untracked noise.
.venv*/
venv/
.pytest_cache/
# pytest-cov is not a project dependency, but a one-off `pytest --cov` run
# would otherwise drop a binary .coverage in the root.
.coverage
.coverage.*
htmlcov/

# Builds & Binaries
dist/
build/
*.exe
*.zip
*.pkg
*.msi
# Generated PyInstaller specs are noise, but the project's own build spec must
# stay versioned or releases cannot be rebuilt.
*.spec
!setup_pyinstaller.spec

# Database & Runtime files
*.db
*.db-shm
*.db-wal
scratch/
restored_sources/
backups/

# Tests, Audits, Benchmarks & Reports
# A bench run snapshots the entire runtime environment into `_warm_profile/`:
# AppData (OneAuth account tokens, IdentityCache, INetCookies), the WebView2
# profile, the pip cache and bench cookies. Reproducible by rerunning the bench,
# and it carries live credentials, so it stays out of version control.
tools/bench/results/_warm_profile/
*.pstats
# NOTE: `tests/` and `run_tests.py` were listed here, which silently kept the
# whole pytest suite out of version control. They are tracked on purpose now:
# every regression test must survive a fresh clone.
.test_runs/
.jscheck/
.audit/
.audit_test_out.txt
benchmarks/
reports/
scripts/
.vite/
user_prompts*.md
out*.txt
prompt*.txt
*.log

# Extraction artifacts (DO NOT COMMIT)
NeDotify.exe_extracted/
AURA_Music.exe_extracted/
pyinstxtractor.py
search_transcript.py
extract_license.py
api_dis.txt
transcript_output.txt
transcript_search.txt
git_phase0.py

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent internal files
.agents/

# Cached album art (generated at runtime)
ui/web_new/covers/
ui/web_new_v2/covers/
*.old.*
*.old
