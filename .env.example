# =====================================================================
# КОНФИГУРАЦИЯ VK БОТА "NeDotify"
# =====================================================================

# Токен сообщества ВКонтакте (Получить: Настройки сообщества -> Работа с API -> Создать токен)
VK_TOKEN=vk1.a.YourCommunityTokenHere...

# Ваш личный VK ID (или ID администратора), куда будут пересылаться баг-репорты
ADMIN_ID=123456789

# Ссылки на скачивание установочных файлов NeDotify
DOWNLOAD_LINK_WIN=https://github.com/nedotify/nedotify/releases/download/v1.0.0/NeDotify_Setup.exe
DOWNLOAD_LINK_LINUX=https://github.com/nedotify/nedotify/releases/download/v1.0.0/NeDotify.AppImage

# Имя/путь к базе данных SQLite
DB_PATH=bot_users.db
